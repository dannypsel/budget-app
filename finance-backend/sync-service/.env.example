# Sync-service environment. Copy to .env and fill in your own values.
# See README.md (the env-vars section) for the full reference.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=
# Service-role key — full access, server-side only. NEVER ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required — Fernet key encrypting Plaid secrets + access tokens at rest (see vault.py).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENC_KEY=

# ── Web app / CORS ───────────────────────────────────────────────────────────
# CORS allowlist for the browser web app — comma-separated origins, scheme included
# (e.g. https://app.example.com,http://localhost:5173).
# NOTE: on AWS Lambda this MUST include the CloudFront origin that serves the
# web app, or the browser's POST /sync/trigger calls will be CORS-blocked.
# (The deploy worker sets the value; the backend only reads it here.)
WEB_ORIGINS=

# ── Plaid (optional house credentials) ───────────────────────────────────────
# Optional legacy "house" Plaid fallback — per-user creds normally live
# Fernet-encrypted in the plaid_credentials table (see plaid_client.py / vault.py).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Sandbox secret for the house client_id; preferred over PLAID_SECRET when set
PLAID_SANDBOX_SECRET=
# Max active Items per Plaid developer account (default 10)
PLAID_ITEM_LIMIT=
# This service's own /link URL for OAuth banks, e.g. https://your-api.example.com/link
# On AWS Lambda the deploy worker sets this to the Function URL + /link.
PLAID_REDIRECT_URI=

# ── Sync cadence ─────────────────────────────────────────────────────────────
# Cooldown (days) between user-triggered full syncs (POST /backfill-all). Default 2.
# There is no scheduler anymore: refresh is manual via POST /sync/trigger.
FULL_SYNC_COOLDOWN_DAYS=

# ── Logging (see logging_setup.py) ───────────────────────────────────────────
# stdout format: json or text (local default); LOG_LEVEL default INFO
LOG_FORMAT=
LOG_LEVEL=

# ── Notification email digest ────────────────────────────────────────────────
# REMOVED in the 2026-09-26 Lambda rebuild: the SMTP digest rode on the daily
# scheduler, which no longer exists. Notifications are in-app only (see
# POST /sync/trigger's summary). The profiles.notify_email_enabled column
# still exists in the schema but nothing reads it.

# ── AI transaction categorization (optional) ─────────────────────────────────
# Classifier provider: jev | gemini | off. Default jev. 'off' disables the AI
# pass (rules + merchant memory still run). Can also be set per-user in
# Settings → AI Categorization (profiles.ai_provider wins over this default).
AI_CLASSIFIER_PROVIDER=
# Jev (TypeSafe) API key — get one at https://typesafe.ai. TYPESAFE_API_KEY is
# accepted as a fallback name. Without it, AI classification is skipped
# gracefully (status 'misconfigured' on /categorize/auto).
JEV_API_KEY=
# Jev model alias (default jev-latest) and direct API URL override.
JEV_MODEL=
JEV_API_URL=
# Confidence threshold 0..1 (default 0.7): verdicts at/above auto-apply, below
# trigger one Brave merchant lookup + re-classify, still-below stays in the
# review queue. Per-user override in Settings (profiles.ai_confidence_threshold).
AI_CONFIDENCE_THRESHOLD=
# Brave Search API key (free tier) — merchant enrichment for low-confidence
# verdicts. Unset = enrichment skipped, low-confidence items go to review.
BRAVE_API_KEY=
# Max transactions classified per pipeline run (default 200).
AI_MAX_TXNS_PER_RUN=
# Max sequential Brave merchant lookups per pipeline run (default 10) and an
# overall pipeline time budget in seconds (default 300). Both keep the manual
# refresh under the Lambda 15-min cap; transactions past the cap go to the
# review queue. Jev classification logic itself is untouched.
AI_MAX_BRAVE_LOOKUPS_PER_RUN=
AI_CATEGORIZE_TIME_BUDGET_S=

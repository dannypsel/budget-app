# Copy to .env and fill in your own values. These VITE_* vars are baked into the
# static build at `npm run build` time (they are public — no secrets here).

# Your Supabase project URL, e.g. https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Your Supabase anon (publishable) key — safe to expose to the browser
VITE_SUPABASE_ANON_KEY=your-anon-key

# The sync-service API base URL (Plaid link + on-demand sync), e.g. your AWS
# Lambda Function URL: https://<id>.lambda-url.<region>.on.aws
# data/sync.ts, data/plaidItems.ts, data/churning.ts, data/aiCategorize.ts and
# data/plaidCredentials.ts read VITE_BACKEND_URL.
VITE_BACKEND_URL=https://your-api.example.com
